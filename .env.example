# TUDO AQUI É OPCIONAL. Sem nenhum .env o sistema se configura sozinho na primeira inicialização:
#  - gera as chaves de segurança e de notificação (salvas em data/secrets.json)
#  - pede para criar o administrador no primeiro acesso pelo navegador

# Onde ficam o banco e as chaves. Em hospedagem com disco que apaga a cada deploy, aponte para uma pasta persistente.
# DATA_DIR=./data

# Porta (a hospedagem normalmente define sozinha)
# PORT=3000

# Define o administrador por variável (dispensa a tela de primeiro acesso e serve para recuperar senha esquecida)
# ADMIN_USER=admin
# ADMIN_PASS=uma-senha-forte

# E-mail de contato exigido pelo padrão Web Push
# VAPID_SUBJECT=mailto:voce@seudominio.com

# Intervalo do monitor de alertas (segundos, mínimo 15)
# MONITOR_INTERVAL_SEC=60

# Duração da sessão do cliente no app instalado
# CLIENT_TOKEN_TTL=30d

# 1 = há proxy da hospedagem na frente (padrão). Use 0 só se expuser o Node diretamente na internet.
# TRUST_PROXY=1
